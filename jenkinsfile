pipeline {
    agent any

    environment {
        APP_VERSION = "1.0.0"
    }

    parameters {
        string(
            name: 'VERSION',
            defaultValue: '1.0.0',
            description: 'Application version'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'prod'],
            description: 'Select environment'
        )

        booleanParam(
            name: 'RUN_TESTS',
            defaultValue: true,
            description: 'Run tests'
        )
    }

    stages {

        stage('Initialize') {
            steps {
                script {
                    utils = load 'script.groovy'
                    utils.showBuildInfo()
                }
            }
        }

        stage('Checkout') {
            steps {
                echo "Fetching source code..."
            }
        }

        stage('Build') {
            steps {
                script {
                    utils.buildApplication()
                }
            }
        }

        stage('Testing') {
            when {
                expression {
                    return params.RUN_TESTS
                }
            }
            steps {
                script {
                    utils.runTests()
                }
            }
        }

        stage('Code Quality') {
            steps {
                script {
                    utils.codeQualityCheck()
                }
            }
        }

        stage('Approval') {
            when {
                expression {
                    return params.ENVIRONMENT == "prod"
                }
            }
            steps {
                input(
                    message: "Deploy to Production?",
                    ok: "Approve"
                )
            }
        }

        stage('Deployment') {
            steps {
                script {
                    utils.deployApplication(params.ENVIRONMENT)
                }
            }
        }

        stage('Verification') {
            steps {
                script {
                    utils.verifyDeployment()
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully"
        }

        failure {
            echo "Pipeline failed"
        }

        always {
            echo "Cleaning workspace"
        }
    }
}
